# Copy to .env and fill in. NEVER commit the filled-in file.
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a && source .env && set +a
#
# .env is already in .gitignore.

# KRX Data Marketplace account (data.krx.co.kr). pykrx 1.2.8+ requires a login
# for the foreign-ownership endpoint.
KRX_ID=
KRX_PW=

# OpenDART key — free, issued instantly at https://opendart.fss.or.kr
# Needed later for dividends / ex-dividend dates / capital changes.
DART_API_KEY=

# Optional overrides
# KRXFLOW_DATA_DIR=/Volumes/Data/kr-foreign-flow
# KRXFLOW_SLEEP=0.7
